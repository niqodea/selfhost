# Config strings to be injected in docker compose yaml files
# Useful to:
# - centralize resource names (e.g. networks)
# - interpolate strings before passing them to container env

COMPOSE_PROJECT_NAME=selfhost

PUID=1000
PGID=1000

DOMAIN=example.com

MAIN_NETWORK=main
MAIN_NETWORK_SUBNET=10.0.0.0/24
# specifying ip range avoids conflicts with static addresses
MAIN_NETWORK_IP_RANGE=10.0.0.128/25
# dnsmasq --address requires ip, --cname doesn't support wildcards
MAIN_NETWORK_CADDY_ADDRESS=10.0.0.1
# manual port forwarding with host iptables rules requires configuring a known ip here
MAIN_NETWORK_WIREGUARD_WAN_ADDRESS=10.0.0.2

GLUETUN_NETWORK=gluetun
# NOTE: We need raw IP config here to route traffic with iptables
GLUETUN_NETWORK_SUBNET=10.0.1.0/24
# specifying ip range avoids conflicts with static addresses
GLUETUN_NETWORK_IP_RANGE=10.0.1.128/25
GLUETUN_NETWORK_GATEWAY_ADDRESS=10.0.1.1
# TODO: Make network table more resilient to accidental collisions
GLUETUN_TABLE=100

CADDY_NETWORK=caddy
CADDY_NETWORK_GIT_ALIAS=git
CADDY_NETWORK_JELLYFIN_ALIAS=jellyfin
CADDY_NETWORK_LIBRESPEED_ALIAS=librespeed
CADDY_NETWORK_PROWLARR_ALIAS=prowlarr
CADDY_NETWORK_QBITTORRENT_ALIAS=qbittorrent
CADDY_NETWORK_RADICALE_ALIAS=radicale
CADDY_NETWORK_VAULTWARDEN_ALIAS=vaultwarden

WIREGUARD_NETWORK_SUBNET=10.0.255.0/32
# Must match first IP of subnet (hardcoded behavior by linuxserver/wireguard)
WIREGUARD_NETWORK_SERVER_ADDRESS=10.0.255.1
# Set to - (stdout) to show DNS queries in docker logs, /dev/null to hide them
WIREGUARD_DNSMASQ_LOG_FACILITY=/dev/null

# Container-specific

# caddy
DYNU_API_KEY=abc123
# ddns-updater
DYNU_USERNAME=johndoe
DYNU_PASSWORD=password123
# wireguard-lan
WIREGUARD_LAN_HOST_PORT=51820
# wireguard-wan
WIREGUARD_WAN_HOST_PORT=51821

# Constants

# See: adr/systemd-startup.md
DOCKER_RESTART=on-failure

# The project has containers spread across multiple files, so we ignore
# warnings about "orphan containers" that detect running containers that do not
# appear in a specific docker-compose.yaml
# NOTE: Configuring this from .env breaks often, see e.g. https://github.com/docker/compose/issues/11967
COMPOSE_IGNORE_ORPHANS=true
