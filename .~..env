# Config strings to be injected in docker compose yaml files
# Useful to:
# - centralize resource names (e.g. networks)
# - interpolate strings before passing them to container env

COMPOSE_PROJECT_NAME=selfhost

# Deployment owner, who owns shared content such as downloads and synced folders
PUID=1000
PGID=1000

DOMAIN=exp.test
# A public DNS server, which answers the domain with the domain's public
# address instead of Caddy's. dnsmasq's --server only takes an ip
PUBLIC_RESOLVER_ADDRESS=10.0.0.5
# A CA certificate to trust, or /dev/null for none
EXTRA_CA_CERTIFICATE_PATH=./..repo/exp/certificates/root.crt

INTERNET_NETWORK=internet
INTERNET_NETWORK_SUBNET=10.0.0.0/24
# specifying ip range avoids conflicts with static addresses
INTERNET_NETWORK_IP_RANGE=10.0.0.128/25
# manual port forwarding with host iptables rules requires configuring a known ip here
INTERNET_NETWORK_WIREGUARD_WAN_ADDRESS=10.0.0.2
# Compose's dns option only takes an ip
INTERNET_NETWORK_DNS_ADDRESS=10.0.0.3
# Nord's server list gives each server as an ip
INTERNET_NETWORK_FAKE_VPN_ADDRESS=10.0.0.4

PEERS_NETWORK=peers
PEERS_NETWORK_SUBNET=10.0.1.0/24
# specifying ip range avoids conflicts with static addresses
PEERS_NETWORK_IP_RANGE=10.0.1.128/25
# Syncthing requires direct connection for file sync
PEERS_NETWORK_SYNCTHING_ADDRESS=10.0.1.1
# dnsmasq --address requires ip, --cname doesn't support wildcards
PEERS_NETWORK_CADDY_ADDRESS=10.0.1.2

GLUETUN_NETWORK=gluetun
# NOTE: We need raw IP config here to route traffic with iptables
GLUETUN_NETWORK_SUBNET=10.0.2.0/24
# specifying ip range avoids conflicts with static addresses
GLUETUN_NETWORK_IP_RANGE=10.0.2.128/25
GLUETUN_NETWORK_GATEWAY_ADDRESS=10.0.2.1
# Compose's dns option only takes an ip
GLUETUN_NETWORK_DNS_ADDRESS=10.0.2.2
# TODO: Make network table more resilient to accidental collisions
GLUETUN_TABLE=100

WEBAPPS_NETWORK=webapps

WIREGUARD_NETWORK_SUBNET=10.0.255.0
# Must match first IP of subnet (hardcoded behavior by linuxserver/wireguard)
WIREGUARD_NETWORK_SERVER_ADDRESS=10.0.255.1
# Set to - (stdout) to show DNS queries in docker logs, /dev/null to hide them
DNS_LOG_FACILITY=/dev/null

# Container-specific

# caddy
# The Caddy module of the domain's DNS provider, which publishes the
# certificate challenge, with its exact version
# Ref: https://caddyserver.com/docs/modules/ (dns.providers.*)
CADDY_DNS_PLUGIN=github.com/caddy-dns/dynu@v1.0.0
DNS_API_TOKEN=abc123
# ddns-updater
# The provider's DynDNS2 update endpoint, which most dynamic DNS providers offer
DDNS_UPDATE_URL=https://api.dynu.com/nic/update
DDNS_USERNAME=johndoe
DDNS_PASSWORD=password123
# immich
IMMICH_DB_PASSWORD=password123
# wireguard-lan
WIREGUARD_LAN_HOST_PORT=51820
# wireguard-wan
WIREGUARD_WAN_HOST_PORT=51821

# Constants

# See: adr/systemd-startup.md
DOCKER_RESTART=on-failure

# The project has containers spread across multiple files, so we ignore
# warnings about "orphan containers" that detect running containers that do not
# appear in a specific docker-compose.yaml
# NOTE: Configuring this from .env breaks often, see e.g. https://github.com/docker/compose/issues/11967
COMPOSE_IGNORE_ORPHANS=true
