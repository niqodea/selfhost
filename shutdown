#!/bin/sh

set -eu

# Ref: adr/systemd-startup.md

root="$(dirname "$(realpath "$0")")"

for module_path in "$root"/apps/* "$root"/infra/*; do
    docker compose --project-directory "$module_path" down

    if [ -f "$module_path/route" ]; then
        "$module_path/route" down
    fi
done

# This file has only networks, and Compose skips those without "--all-resources"
docker compose --project-directory "$root" --all-resources down
