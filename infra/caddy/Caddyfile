# Caddy's default format uses tabs
# Ref: https://caddy.community/t/caddyfile-warning/13701/2
{
	# email your-email@example.com
	# log {
	#	level DEBUG
	# }
}

*.{$DOMAIN} {
	tls {
		dns dynu {
			api_token {$DNS_API_TOKEN}
			own_domain {$DOMAIN}
		}
		# The DNS servers the containers use answer the domain with Caddy's
		# address and have none of its TXT records, so Caddy looks up the
		# challenge record through its DNS proxy, which asks a public DNS server
		resolvers caddy-dns-proxy:53
	}

	# Caddy runs only the first handle block that matches, and keeps blocks with
	# named matchers in the order written, so this one stays above the apps'
	# Ref: https://caddyserver.com/docs/caddyfile/directives#sorting-algorithm
	@guest-unshared {
		remote_ip {$PEERS_NETWORK_WIREGUARD_GUEST_ADDRESS}
		not host streamling.{$DOMAIN}
	}
	handle @guest-unshared {
		respond "Not found" 404
	}

	@git host git.{$DOMAIN}
	handle @git {
		reverse_proxy git:80
	}

	@immich host immich.{$DOMAIN}
	handle @immich {
		reverse_proxy immich:2283
	}

	@importer host importer.{$DOMAIN}
	handle @importer {
		reverse_proxy importer:8080
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@librespeed host librespeed.{$DOMAIN}
	handle @librespeed {
		reverse_proxy librespeed:8080
	}

	@ntfy host ntfy.{$DOMAIN}
	handle @ntfy {
		reverse_proxy ntfy:80
	}

	@prowlarr host prowlarr.{$DOMAIN}
	handle @prowlarr {
		reverse_proxy prowlarr:9696
	}

	@qbittorrent host qbittorrent.{$DOMAIN}
	handle @qbittorrent {
		reverse_proxy qbittorrent:8080
	}

	@radicale host radicale.{$DOMAIN}
	handle @radicale {
		reverse_proxy radicale:5232
	}

	@seedling host seedling.{$DOMAIN}
	handle @seedling {
		reverse_proxy seedling:8080
	}

	@streamling host streamling.{$DOMAIN}
	handle @streamling {
		reverse_proxy streamling:8080
	}

	@syncthing host syncthing.{$DOMAIN}
	handle @syncthing {
		reverse_proxy syncthing:8384
	}

	@vaultwarden host vaultwarden.{$DOMAIN}
	handle @vaultwarden {
		reverse_proxy vaultwarden:80
	}

	handle {
		respond "Not found" 404
	}
}
