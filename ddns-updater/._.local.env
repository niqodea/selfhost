CONFIG={"settings":[{"provider":"dynu","domain":"${DOMAIN}","username":"johndoe","password":"password123"}]}
# ddns-updater takes host:port, and the public DNS server's address is an ip
RESOLVER_ADDRESS=${PUBLIC_RESOLVER_ADDRESS}:53
# With exp's CA in /etc/ssl/certs, ddns-updater stops trusting the public CAs,
# so it asks the fake Dynu for the public IP too. Without these two lines, it
# asks public providers over TLS
PUBLICIP_FETCHERS=http
PUBLICIP_HTTP_PROVIDERS=url:https://fake-dynu/ip
