#!/bin/sh

set -eu

# Ref: adr/systemd-startup.md

root="$(dirname "$(realpath "$0")")"

# The apps resolve names through the DNS services defined here, and
# "--all-resources" also creates the networks those services do not join
docker compose --project-directory "$root" --all-resources up --detach

for app_path in "$root"/*; do
    if ! [ -d "$app_path" ]; then
        continue
    fi

    if [ -f "$app_path/route" ]; then
        "$app_path/route" up
    fi

    docker compose --project-directory "$app_path" up --detach
done
