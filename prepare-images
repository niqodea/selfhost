#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

docker compose --project-directory "$root" pull
docker compose --project-directory "$root" build

for app_path in "$root"/*; do
    if ! [ -d "$app_path" ]; then
        continue
    fi

    docker compose --project-directory "$app_path" pull
    docker compose --project-directory "$app_path" build
done
