#!/bin/sh
set -eu

# Runs startup of the deployment at $1 in the rootless daemon's network

deployment_path="$1"

state_path="$XDG_RUNTIME_DIR/dockerd-rootless"

# Containers live in a network namespace that rootlesskit detaches into a file,
# which is only mounted inside rootlesskit's mount namespace
# Ref: https://github.com/rootless-containers/rootlesskit/blob/master/docs/network.md
nsenter --preserve-credentials --user --mount --target "$(cat "$state_path/child_pid")" -- \
    nsenter --net="$state_path/netns" \
    env DOCKER_HOST="unix://$XDG_RUNTIME_DIR/docker.sock" "$deployment_path/startup"
