#!/bin/sh
set -eu

# Starts the user's rootless Docker daemon, which stops with the machine
# Ref: https://docs.docker.com/engine/security/rootless/

if [ -S "$XDG_RUNTIME_DIR/docker.sock" ]; then
    >&2 echo "Error: a daemon already listens at $XDG_RUNTIME_DIR/docker.sock"
    exit 1
fi

# Unlike the default port driver, the implicit one keeps the source address of
# UDP clients, and it needs the pasta network driver
# Ref: https://github.com/rootless-containers/rootlesskit/blob/master/docs/port.md
export DOCKERD_ROOTLESS_ROOTLESSKIT_NET=pasta
export DOCKERD_ROOTLESS_ROOTLESSKIT_PORT_DRIVER=implicit
# The default 10.0.2.0/24 collides with Docker networks, while RFC 2544 reserves
# 198.18.0.0/15 for benchmarks, so no network uses it
# Ref: https://www.rfc-editor.org/rfc/rfc2544#appendix-C.2.2
export DOCKERD_ROOTLESS_ROOTLESSKIT_FLAGS='--cidr=198.18.0.0/24'

# setsid detaches the daemon from the terminal, so it outlives the SSH session
setsid dockerd-rootless.sh > "$XDG_RUNTIME_DIR/dockerd-rootless.log" 2>&1 < /dev/null &

for second in $(seq 30); do
    if [ -S "$XDG_RUNTIME_DIR/docker.sock" ]; then
        echo 'Success'
        exit 0
    fi
    sleep 1
done

>&2 echo "Error: no daemon after 30 seconds, see $XDG_RUNTIME_DIR/dockerd-rootless.log"
exit 1
