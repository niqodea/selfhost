#!/bin/sh
set -eux

root="$(dirname "$(realpath "$0")")"

get_env_var() {
    value="$(sed -n "s/^$1=//p" "$root/.env")"
    if [ -z "$value" ]; then
        >&2 echo "Error: $1 not found in .env"
        return 1
    fi
    printf '%s' "$value"
}

GLUETUN_NETWORK_SUBNET="$(get_env_var 'GLUETUN_NETWORK_SUBNET')"

case "${1:-}" in
    up|down)
        ;;
    *)
        echo "Usage: $0 {up|down}" >&2
        exit 1
        ;;
esac

# Docker runs up before every start, so up first removes the copies that
# earlier starts added
for rule in 'blackhole' "to $GLUETUN_NETWORK_SUBNET lookup main"; do
    while ip rule del from "$GLUETUN_NETWORK_SUBNET" $rule 2> /dev/null; do :; done
done

# The last priorities before the main table at 32766, so these only catch
# traffic that no earlier rule routes
# Ref: adr/systemd-startup.md
if [ "$1" = up ]; then
    # allow local traffic
    ip rule add priority 32760 from "$GLUETUN_NETWORK_SUBNET" to "$GLUETUN_NETWORK_SUBNET" lookup main
    # drop traffic by default
    ip rule add priority 32761 from "$GLUETUN_NETWORK_SUBNET" blackhole
fi
