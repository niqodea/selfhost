# Caddy's default format uses tabs
# Ref: https://caddy.community/t/caddyfile-warning/13701/2
{
	# email your-email@example.com
	# log {
	#	level DEBUG
	# }
}

*.{$DOMAIN} {
	tls {
		dns dynu {
			api_token {$DYNU_API_KEY}
			own_domain {$DOMAIN}
		}
	}

	@{$JELLYFIN_ID} host {$JELLYFIN_ID}.{$DOMAIN}
	handle @{$JELLYFIN_ID} {
		reverse_proxy {$JELLYFIN_ID}:8096
	}

	@{$LIBRESPEED_ID} host {$LIBRESPEED_ID}.{$DOMAIN}
	handle @{$LIBRESPEED_ID} {
		reverse_proxy {$LIBRESPEED_ID}:80
	}

	@{$PROWLARR_ID} host {$PROWLARR_ID}.{$DOMAIN}
	handle @{$PROWLARR_ID} {
		reverse_proxy {$PROWLARR_ID}:9696
	}

	@{$QBITTORRENT_ID} host {$QBITTORRENT_ID}.{$DOMAIN}
	handle @{$QBITTORRENT_ID} {
		reverse_proxy {$QBITTORRENT_ID}:8080
	}

	@{$SYNCTHING_ID} host {$SYNCTHING_ID}.{$DOMAIN}
	handle @{$SYNCTHING_ID} {
		reverse_proxy {$SYNCTHING_ID}:8384
	}

	handle {
		respond "Not found" 404
	}
}
