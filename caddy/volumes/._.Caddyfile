# Caddy's default format uses tabs
# Ref: https://caddy.community/t/caddyfile-warning/13701/2
{
	# email your-email@example.com
	# log {
	#	level DEBUG
	# }
}

*.{$DOMAIN} {
	tls {
		dns dynu {
			api_token {$DYNU_API_KEY}
			own_domain {$DOMAIN}
		}
		# The stack's resolvers answer the domain with Caddy's address and
		# have none of its TXT records, so Caddy looks up the challenge record
		# through a public resolver
		resolvers {$PUBLIC_RESOLVER_ADDRESS}
	}

	@git host git.{$DOMAIN}
	handle @git {
		reverse_proxy git:80
	}

	@immich host immich.{$DOMAIN}
	handle @immich {
		reverse_proxy immich:2283
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@librespeed host librespeed.{$DOMAIN}
	handle @librespeed {
		reverse_proxy librespeed:8080
	}

	@prowlarr host prowlarr.{$DOMAIN}
	handle @prowlarr {
		reverse_proxy prowlarr:9696
	}

	@qbittorrent host qbittorrent.{$DOMAIN}
	handle @qbittorrent {
		reverse_proxy qbittorrent:8080
	}

	@radicale host radicale.{$DOMAIN}
	handle @radicale {
		reverse_proxy radicale:5232
	}

	@syncthing host syncthing.{$DOMAIN}
	handle @syncthing {
		reverse_proxy syncthing:8384
	}

	@vaultwarden host vaultwarden.{$DOMAIN}
	handle @vaultwarden {
		reverse_proxy vaultwarden:80
	}

	handle {
		respond "Not found" 404
	}
}
