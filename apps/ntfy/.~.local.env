# name:hash:role, each hash from `ntfy user hash`. ntfy needs a hash even for
# a user that logs in only with a token. The single quotes stop Compose from
# reading the $ in a hash as a variable
NTFY_AUTH_USERS='phone:$2a$10$BtJCtFNSwbxqWEZRAHu2b.vvxrG8HDsDhKI5idbmZy9fXHYuLljZa:user,alert:$2a$10$BtJCtFNSwbxqWEZRAHu2b.vvxrG8HDsDhKI5idbmZy9fXHYuLljZa:user'
# alert's token, from `ntfy token generate`
NTFY_AUTH_TOKENS=alert:tk_00000000000000000000000000000
# The same token, which the ntfy command in the container logs in with
NTFY_TOKEN=tk_00000000000000000000000000000
