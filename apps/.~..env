# Config strings to be injected in docker compose yaml files
# Allows preprocess of base env vars into different names/values for containers

# Shared

DOMAIN=example.com
HOST_NETWORK_SUBNET=0.0.0.0/32
MAIN_NETWORK=main-network
MAIN_NETWORK_SUBNET=0.0.0.0/32
MAIN_NETWORK_CADDY_ADDRESS=0.0.0.0
MAIN_NETWORK_IP_RANGE=0.0.0.0/32  # avoid conflicts with static caddy address
PUBLIC_DNS_ADDRESS=0.0.0.0
CADDY_NETWORK=caddy-network
WIREGUARD_NETWORK_SERVER_ADDRESS=0.0.0.0
WIREGUARD_NETWORK_SUBNET=0.0.0.0

# Container-specific

DYNU_API_KEY=abc123
DYNU_USERNAME=johndoe
DYNU_PASSWORD=password123
FILEBROWSER_SHARE_VOLUME=/path/to/volume
WIREGUARD_SERVERPORT=00000
WIREGUARD_GLUETUN_SERVERPORT=00000
