# Global options
{
	email your-email@example.com
	# Uncomment for debug logging
	# log {
	# 	level DEBUG
	# }
}

# Wildcard cert for all subdomains
*.{$DOMAIN} {
	tls {
		dns dynu {env.DYNU_API_KEY}
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy jellyfin:8096
	}

	@qbittorrent host qbittorrent.{$DOMAIN}
	handle @qbittorrent {
		reverse_proxy qbittorrent:8080
	}

	@librespeed host librespeed.{$DOMAIN}
	handle @librespeed {
		reverse_proxy librespeed:80
	}

	handle {
		respond "Not found" 404
	}
}
