# Caddy's default format uses tabs
# Ref: https://caddy.community/t/caddyfile-warning/13701/2
{
	# email your-email@example.com
	# log {
	#	level DEBUG
	# }
}

*.{$DOMAIN} {
	tls {
		dns dynu {
			api_token {$DYNU_API_KEY}
			own_domain {$DOMAIN}
		}
	}

	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		reverse_proxy {$JELLYFIN_ALIAS}:8096
	}

	@librespeed host librespeed.{$DOMAIN}
	handle @librespeed {
		reverse_proxy {$LIBRESPEED_ALIAS}:80
	}

	@prowlarr host prowlarr.{$DOMAIN}
	handle @prowlarr {
		reverse_proxy {$PROWLARR_ALIAS}:9696
	}

	@qbittorrent host qbittorrent.{$DOMAIN}
	handle @qbittorrent {
		reverse_proxy {$QBITTORRENT_ALIAS}:8080
	}

	handle {
		respond "Not found" 404
	}
}
