#!/bin/sh
set -eu

# Installs a deployment as on a server, and adds exp to it: the fakes and their
# CA, the samples plugged as sockets, and empty content owned by the deployment
# owner. Then it starts the fakes

root="$(dirname "$(realpath "$0")")/..repo"

deployment_path="$1"

"$root/host-setup/install-deployment" "$deployment_path"

cp -P -R "$root/exp" "$deployment_path/exp"

find "$deployment_path" -type f -name '.~.*' | while IFS= read -r sample; do
    sample_name="$(basename "$sample")"
    cp "$sample" "$(dirname "$sample")/._.${sample_name#.~.}"
done

owner="$(sed -n 's/^PUID=//p' "$deployment_path/.env"):$(sed -n 's/^PGID=//p' "$deployment_path/.env")"
for plug in "$deployment_path"/apps/*/content/*; do
    socket="$(dirname "$plug")/$(readlink "$plug")"
    mkdir "$socket"
    chown "$owner" "$socket"
done

"$deployment_path/exp/generate-certificates"

# Docker starts the fakes on boot only once they exist, so they start here,
# before the startup service is enabled. The first command creates the networks
# they join
docker compose --project-directory "$deployment_path" --all-resources up --detach
docker compose --project-directory "$deployment_path/exp/fake-vpn" up --detach
docker compose --project-directory "$deployment_path/exp/fake-dynu" up --detach
docker compose --project-directory "$deployment_path/exp/fake-letsencrypt" up --detach

echo 'Success'
