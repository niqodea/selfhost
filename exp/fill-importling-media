#!/bin/sh
set -eu

# Replaces importling's media with toy torrents, some it imports on its own
# and some it asks about, and starts importling over with no state. The
# videos are empty files of the size of real ones, which take no space

deployment_path="$1"

# The deployment owner is named after the Compose project
owner="$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$deployment_path/.env")"
module="$deployment_path/apps/importling"
media="$module/content/$(readlink "$module/content/media")"
state="$module/volumes/$(readlink "$module/volumes/state")"
downloads="$media/downloads"

docker compose --project-directory "$module" --progress=quiet stop
rm -rf "${media:?}"/* "${state:?}"/*

video() {
    mkdir --parents "$(dirname "$downloads/$1")"
    truncate --size "$2" "$downloads/$1"
}

# Imported on their own
video 'The.Office.US.S02.1080p.WEB-DL.x264-GRP/The.Office.US.S02E01.1080p.WEB-DL.x264-GRP.mkv' 1G
video 'The.Office.US.S02.1080p.WEB-DL.x264-GRP/The.Office.US.S02E02.1080p.WEB-DL.x264-GRP.mkv' 1G
video 'The.Office.US.S02.1080p.WEB-DL.x264-GRP/Sample/the.office.us.s02e01.sample.mkv' 30M
video 'Breaking Bad Season 2 Complete 720p/01 - Seven Thirty-Seven.mkv' 700M
video 'Breaking Bad Season 2 Complete 720p/02 - Grilled.mkv' 700M
video 'Doctor.Who.2005.S01E02.The.End.of.the.World.720p.mkv' 900M
video 'We.Bare.Bears.S01E14.1080p.WEB-DL/mxNMuJWeO7PUWCMEwqKSsS6D8Vs9S6V3PHD.mkv' 500M

# Left alone, since one file holds two episodes
video "Friends - [7x23-24] - The One with Monica and Chandler's Wedding.mkv" 800M

# Asked about: names with no season or episode, and names that leave doubt
video 'Fargo.1996.1080p.BluRay.x264-GRP/Fargo.1996.1080p.BluRay.x264-GRP.mkv' 8G
video 'Daily.Show.2024.03.12.Guest.720p.mkv' 600M
video '[SubsPlease] Frieren - 05 (1080p) [ABCD1234].mkv' 1G
video 'Avatar.The.Last.Airbender.Book.1.Water/01 The Boy in the Iceberg.avi' 300M
video 'Avatar.The.Last.Airbender.Book.1.Water/02 The Avatar Returns.avi' 300M
video 'Show.S01/Show.S01E01.mkv' 700M
video 'Show.S01/Show.S01E01.REPACK.mkv' 700M
video '超能警探.Memorist.S01E01.2160p.mkv' 1G

chown --recursive "$owner:$owner" "$media"
chmod --recursive g+rwX "$media"

docker compose --project-directory "$module" --progress=quiet start

echo 'Success'
