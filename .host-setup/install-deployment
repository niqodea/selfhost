#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")/..repo"

deployment_path="$1"

if [ -e "$deployment_path" ]; then
    >&2 echo "File already exists at $deployment_path"
    exit 1
fi

# - Install key top-level files
# - Install non-hidden top-level directories
# - Ignore sockets anywhere
rsync -glor \
    --include='/docker-compose.yaml' \
    --include='/dns.Dockerfile' \
    --include='/dns.Dockerfile.dockerignore' \
    --include='/route-failsafe' \
    --include='/startup' \
    --include='/.env' \
    --include='/..repo' \
    --exclude='/.*' \
    --include='/*/' \
    --exclude='/*' \
    --exclude='._.*' \
    --exclude='.=.*' \
    "$root/" "$deployment_path"

# The checkout's socket files are the exp deployment's config, so they become
# samples for this deployment's own sockets
find -H "$root" \( -path "$root/.*" -type d -o -name '.=.*' \) -prune \
    -o -type f -name '._.*' -print | while IFS= read -r socket; do
    relative_path="${socket#"$root"/}"
    socket_name="$(basename "$relative_path")"
    cp "$socket" "$deployment_path/$(dirname "$relative_path")/.~.${socket_name#._.}"
done

echo 'Success'
