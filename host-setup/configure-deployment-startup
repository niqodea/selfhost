#!/bin/sh
set -eu

root="$(dirname "$(realpath "$0")")/..repo"

deployment_path="$1"
action="$2"

systemd_escaped_deployment_path="$(systemd-escape --path "$deployment_path")"

for file in 'route-failsafe' 'startup'; do
    if [ ! -e "$deployment_path/$file" ]; then
        >&2 echo "Missing base file $deployment_path/$file"
        exit 1
    fi
done

docker_dropins_path="/etc/systemd/system/docker.service.d"
if [ ! -e "$docker_dropins_path" ]; then
    >&2 echo "Missing Docker service dropins units directory at $docker_dropins_path"
    exit 1
fi

docker_dropin_path="$docker_dropins_path/selfh-route-failsafe-$systemd_escaped_deployment_path.conf"
# Docker closes the failsafe before every start, and does not start when that
# fails. A failsafe unit of its own would stop Docker whenever it is stopped
docker_dropin_content="$(cat << EOF
[Service]
ExecStartPre=$deployment_path/route-failsafe up
EOF
)"

case "$action" in
    up)
        printf '%s\n' "$docker_dropin_content" > "$docker_dropin_path"
        # Docker is already running, so the failsafe closes now too
        "$deployment_path/route-failsafe" up
        systemctl enable "selfh-startup@${systemd_escaped_deployment_path}.service"
        ;;
    down)
        systemctl disable "selfh-startup@${systemd_escaped_deployment_path}.service"
        rm "$docker_dropin_path"
        ;;
    *)
        echo "Usage: $0 <deployment_path> {up|down}" >&2
        exit 1
        ;;
esac

systemctl daemon-reload

echo 'Success'
