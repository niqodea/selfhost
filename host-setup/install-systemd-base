#!/bin/sh
set -eu

root="$(dirname "$(realpath "$0")")/..repo"

# WireGuard containers use the host's kernel-space WireGuard module.
# By loading the module at the host level, we avoid granting containers the
# dangerous SYS_MODULE capability, which would allow them to load arbitrary
# kernel modules.
# NOTE: This configures module loading at boot. To load immediately in the
# current session, run `modprobe wireguard`
wireguard_module_path='/etc/modules-load.d/wireguard.conf'
if [ -e "$wireguard_module_path" ]; then
    >&2 echo "Error: file already exists at $wireguard_module_path"
    exit 1
fi
echo 'wireguard' > '/etc/modules-load.d/wireguard.conf'

# TODO: Enable userns-remap in /etc/docker/daemon.json, so that a container
# whose image runs as root is not root on the host
docker_dropins_path='/etc/systemd/system/docker.service.d'
mkdir "$docker_dropins_path"
echo "Initialized Docker service drop-in units directory at $docker_dropins_path"

startup_service_path="/etc/systemd/system/selfh-startup@.service"
backup_service_path="/etc/systemd/system/selfh-backup@.service"
backup_timer_path="/etc/systemd/system/selfh-backup@.timer"
for path in "$startup_service_path" "$backup_service_path" "$backup_timer_path"; do
    if [ -e "$path" ]; then
        >&2 echo "Error: file already exists at $path"
        exit 1
    fi
done

cat > "$startup_service_path" << 'EOF'
[Unit]
Description=Start selfh at %f
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=%f/startup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
echo "Installed at $startup_service_path"

cat > "$backup_service_path" << 'EOF'
[Unit]
Description=Back up selfh at %f
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=%f/backup/run
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=%C/restic
EOF
cat > "$backup_timer_path" << 'EOF'
[Unit]
Description=Back up selfh at %f every night

[Timer]
OnCalendar=*-*-* 04:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
echo "Installed at $backup_service_path and $backup_timer_path"

systemctl daemon-reload

echo 'Success'
